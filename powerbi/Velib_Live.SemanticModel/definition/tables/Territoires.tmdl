/// Communes desservies et arrondissements de Paris : population INSEE 2019 (carreaux 200 m) et couverture à 300 m de marche.
table Territoires
	lineageTag: a581ab27-6f9b-4403-9263-37973e4af7f9

	measure 'Population totale' = SUM(Territoires[population])
		formatString: #,0
		lineageTag: eb5f714a-ff3d-4a8b-9ddd-2c30e4dde662

	measure 'Population couverte' = SUM(Territoires[population_couverte])
		formatString: #,0
		lineageTag: 67a602e9-7a69-4043-9506-790c6480515c

	measure 'Taux de couverture' = DIVIDE([Population couverte], [Population totale])
		formatString: 0.0 %
		lineageTag: 81b4d014-6545-4f68-a801-cf88b584171c

	measure 'Habitants non couverts' = [Population totale] - [Population couverte]
		formatString: #,0
		lineageTag: 5f878ca8-b2f5-4687-8026-77005d46cf52

	measure 'Bornes pour 1 000 habitants' = DIVIDE(SUM(Territoires[bornes]), [Population totale]) * 1000
		formatString: 0.0
		lineageTag: 9886a310-5015-44c9-968a-537e0890fee6

	column code
		dataType: string
		lineageTag: 48be5c2c-0291-4a50-baf7-3d4b461ee7fb
		summarizeBy: none
		sourceColumn: code

		annotation SummarizationSetBy = Automatic

	column nom
		dataType: string
		lineageTag: a7a088eb-b55c-4f01-b1f8-f5a1f01e8943
		summarizeBy: none
		sourceColumn: nom

		annotation SummarizationSetBy = Automatic

	column departement
		dataType: string
		lineageTag: b490d25b-2c08-4708-a5fd-39e1ed937ad2
		summarizeBy: none
		sourceColumn: departement

		annotation SummarizationSetBy = Automatic

	column population
		dataType: int64
		formatString: #,0
		lineageTag: a8393a24-c301-490d-ad88-3e942ea32dd5
		summarizeBy: sum
		sourceColumn: population

		annotation SummarizationSetBy = Automatic

	column population_couverte
		dataType: int64
		formatString: #,0
		lineageTag: 4be6201c-c777-4035-90f8-427ae843c17f
		summarizeBy: sum
		sourceColumn: population_couverte

		annotation SummarizationSetBy = Automatic

	column taux_couverture
		dataType: double
		formatString: 0.0 %
		lineageTag: 4109943c-ef06-43df-a813-e2b010aea818
		summarizeBy: none
		sourceColumn: taux_couverture

		annotation SummarizationSetBy = Automatic

	column stations
		dataType: int64
		formatString: 0
		lineageTag: c869ba7f-f360-4be9-8a80-d1ca4fc99f12
		summarizeBy: sum
		sourceColumn: stations

		annotation SummarizationSetBy = Automatic

	column bornes
		dataType: int64
		formatString: #,0
		lineageTag: 9eacccf5-b989-4a77-a947-48b702641fde
		summarizeBy: sum
		sourceColumn: bornes

		annotation SummarizationSetBy = Automatic

	column bornes_pour_1000_hab
		dataType: double
		formatString: 0.0
		lineageTag: fe279607-2914-4e39-aa59-f5cca1e256d9
		summarizeBy: none
		sourceColumn: bornes_pour_1000_hab

		annotation SummarizationSetBy = Automatic

	column lat
		dataType: double
		lineageTag: 42808da7-e824-4038-a159-753bf7778753
		dataCategory: Latitude
		summarizeBy: none
		sourceColumn: lat

		annotation SummarizationSetBy = Automatic

	column lon
		dataType: double
		lineageTag: cdb1c222-8cee-4513-b40f-5f3885f4a007
		dataCategory: Longitude
		summarizeBy: none
		sourceColumn: lon

		annotation SummarizationSetBy = Automatic

	partition Territoires = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DossierDonnees & "territoires.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Types = Table.TransformColumnTypes(Entetes, {{"code", type text}, {"nom", type text}, {"departement", type text}, {"population", Int64.Type}, {"population_couverte", Int64.Type}, {"taux_couverture", type number}, {"stations", Int64.Type}, {"bornes", Int64.Type}, {"bornes_pour_1000_hab", type number}, {"lat", type number}, {"lon", type number}}, "en-US")
				in
				    Types

	annotation PBI_ResultType = Table

